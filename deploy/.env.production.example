# Serverda /opt/uniflow/.env fayliga nusxalang va qiymatlarni o'zgartiring.

# Domen (HTTPS avtomatik). Domen bo'lmasa ":80" qoldiring (faqat HTTP, IP orqali).
SITE_ADDRESS=uniflow.uz

# Image teglari (odatda latest; orqaga qaytish uchun commit SHA yozing)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=uniflow

# JWT (openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Birinchi SUPERADMIN (seed)
ADMIN_EMAIL=admin@uniflow.uz
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_PHONE=+998900000000

# Sayt manzili (email xatlari uchun) va ruxsat etilgan domenlar
APP_URL=https://uniflow.uz
CORS_ORIGINS=https://uniflow.uz

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="UniFlow <your@gmail.com>"
