# APPLICATION PORT
PORT=3000

# DATABASE (lokal ishga tushirish uchun)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/uniflow?schema=public"

# DOCKER POSTGRES (docker-compose shu qiymatlardan foydalanadi)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=uniflow

# JWT (kamida 32 belgili tasodifiy qatorlar: openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# SEED SUPERADMIN
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_PHONE=+998900000000

# FRONTEND manzili (email xatidagi havola va logo uchun)
APP_URL=http://localhost:5173

# CORS (vergul bilan ajrating). Bo'sh bo'lsa barcha domenlarga ruxsat beriladi
CORS_ORIGINS=

# EMAIL (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="UniFlow <your@gmail.com>"
